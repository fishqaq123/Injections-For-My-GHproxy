            "position": "afterBody",
            "html": "<!-- ====== 磨砂玻璃背景层 ====== -->\n<style>\n  /* 背景层：固定在底层，渐变背景 */\n  #glass-bg {\n    position: fixed !important;\n    top: 0 !important;\n    left: 0 !important;\n    width: 100% !important;\n    height: 100% !important;\n    background: linear-gradient(145deg, #0b0e1a, #1a1435) !important;\n    z-index: 0 !important;\n    pointer-events: none !important;\n  }\n  /* 磨砂玻璃容器 */\n  #glass-wrapper {\n    position: relative !important;\n    z-index: 1 !important;\n    max-width: 780px !important;\n    width: 100% !important;\n    padding: 30px 40px 30px !important;\n    border-radius: 24px !important;\n    background: rgba(255, 255, 255, 0.06) !important;\n    backdrop-filter: blur(20px) saturate(1.4) !important;\n    -webkit-backdrop-filter: blur(20px) saturate(1.4) !important;\n    border: 1px solid rgba(255, 255, 255, 0.08) !important;\n    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.06) !important;\n    box-sizing: border-box !important;\n    margin: 20px 0 !important;\n  }\n  /* 原页面 body 改为 flex 容器居中，并清空背景 */\n  body {\n    background: transparent !important;\n    padding: 20px !important;\n    min-height: 100vh !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    flex-direction: column !important;\n  }\n  /* 原内容字体颜色适配深色背景 */\n  #glass-wrapper h1,\n  #glass-wrapper p,\n  #glass-wrapper .tips,\n  #glass-wrapper .example,\n  #glass-wrapper a {\n    color: #f0f0f5 !important;\n  }\n  #glass-wrapper .tips,\n  #glass-wrapper .example {\n    color: rgba(255, 255, 255, 0.7) !important;\n  }\n  #glass-wrapper a {\n    color: #a78bfa !important;\n  }\n  /* 标题字号调小 */\n  #glass-wrapper h1 {\n    font-size: 22px !important;\n    font-weight: 600 !important;\n    letter-spacing: -0.02em !important;\n    margin-bottom: 16px !important;\n  }\n  #glass-wrapper input.url {\n    background: rgba(255, 255, 255, 0.08) !important;\n    color: #fff !important;\n    border-color: rgba(255, 255, 255, 0.2) !important;\n  }\n  #glass-wrapper input.url::placeholder {\n    color: rgba(255, 255, 255, 0.4) !important;\n  }\n  #glass-wrapper .btn {\n    background: linear-gradient(135deg, #7c6df0, #a78bfa) !important;\n    box-shadow: 0 8px 24px rgba(124, 109, 240, 0.3) !important;\n  }\n  #glass-wrapper .btn:hover {\n    background: linear-gradient(135deg, #6d5de0, #967bea) !important;\n  }\n  /* 彻底隐藏原角标（包括被移动后） */\n  [style*=\"position: absolute\"][style*=\"top: 0\"][style*=\"right: 0\"],\n  a[href=\"https://github.com/hunshcn/gh-proxy\"] img {\n    display: none !important;\n  }\n  body > a[style*=\"position: absolute\"][style*=\"top: 0\"][style*=\"right: 0\"] {\n    display: none !important;\n  }\n  /* 隐藏原底部版权文字 */\n  body.flex > p:last-of-type {\n    display: none !important;\n  }\n\n  /* ====== 右上角 GitHub 徽章按钮（替换原角标） ====== */\n  #github-corner-btn {\n    position: fixed !important;\n    top: 20px !important;\n    right: 20px !important;\n    z-index: 99999 !important;\n    display: inline-flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n    padding: 8px 16px !important;\n    background: #24292f !important;\n    color: #ffffff !important;\n    border-radius: 8px !important;\n    text-decoration: none !important;\n    font-size: 14px !important;\n    font-weight: 500 !important;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;\n    border: 1px solid #3d444d !important;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.3) !important;\n    transition: background 0.2s, transform 0.15s !important;\n    backdrop-filter: blur(4px) !important;\n    background-color: rgba(36, 41, 47, 0.9) !important;\n  }\n  #github-corner-btn:hover {\n    background: #1c2026 !important;\n    transform: scale(1.04) !important;\n    text-decoration: none !important;\n    color: #ffffff !important;\n  }\n  #github-corner-btn svg {\n    flex-shrink: 0 !important;\n  }\n  @media (max-width: 600px) {\n    #github-corner-btn {\n      top: 12px !important;\n      right: 12px !important;\n      padding: 6px 12px !important;\n      font-size: 12px !important;\n    }\n  }\n\n  /* ====== 两个悬浮球共用样式 ====== */\n  .floating-btn {\n    position: fixed !important;\n    z-index: 99999 !important;\n    display: block !important;\n  }\n  .floating-btn a {\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    gap: 6px !important;\n    width: 56px !important;\n    height: 56px !important;\n    border-radius: 50% !important;\n    background: #0969da !important;\n    color: #ffffff !important;\n    text-decoration: none !important;\n    font-size: 13px !important;\n    font-weight: 500 !important;\n    box-shadow: 0 4px 12px rgba(9, 105, 218, 0.35) !important;\n    transition: all 0.25s ease !important;\n    border: none !important;\n    cursor: pointer !important;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;\n    line-height: 1.2 !important;\n    text-align: center !important;\n    letter-spacing: 0.3px !important;\n    word-break: keep-all !important;\n    white-space: nowrap !important;\n    padding: 0 !important;\n    transform: scale(1) !important;\n  }\n  .floating-btn a:hover {\n    background: #0550ae !important;\n    box-shadow: 0 6px 20px rgba(9, 105, 218, 0.5) !important;\n    transform: scale(1.05) !important;\n    text-decoration: none !important;\n    color: #ffffff !important;\n  }\n  @media (max-width: 480px) {\n    .floating-btn a {\n      width: 48px !important;\n      height: 48px !important;\n      font-size: 12px !important;\n    }\n  }\n  .floating-btn,\n  .floating-btn * {\n    visibility: visible !important;\n    opacity: 1 !important;\n    pointer-events: auto !important;\n  }\n  /* 右下角返回按钮 */\n  #floating-back {\n    bottom: 30px !important;\n    right: 30px !important;\n  }\n  /* 左下角兼容模式切换按钮 */\n  #floating-compat {\n    bottom: 30px !important;\n    left: 30px !important;\n  }\n  @media (max-width: 480px) {\n    #floating-back {\n      bottom: 20px !important;\n      right: 20px !important;\n    }\n    #floating-compat {\n      bottom: 20px !important;\n      left: 20px !important;\n    }\n  }\n\n  /* 兼容模式下隐藏所有注入内容（由 Worker 参数控制，此样式保留备用） */\n  body.compat-mode #glass-bg,\n  body.compat-mode #glass-wrapper,\n  body.compat-mode .floating-btn,\n  body.compat-mode #github-corner-btn {\n    display: none !important;\n  }\n</style>\n\n<!-- ====== 背景层 ====== -->\n<div id=\"glass-bg\"></div>\n\n<!-- ====== 右上角 GitHub 徽章按钮 ====== -->\n<a id=\"github-corner-btn\" href=\"https://github.com/hunshcn/gh-proxy\" target=\"_blank\" rel=\"noopener noreferrer\">\n  <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"white\">\n    <path d=\"M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.15 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.62.24 2.85.12 3.15.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z\"/>\n  </svg>\n  <span>GitHub</span>\n</a>\n\n<!-- ====== 磨砂玻璃容器（内容将被 JS 移入） ====== -->\n<div id=\"glass-wrapper\"></div>\n\n<!-- ====== 右下角返回按钮 ====== -->\n<div id=\"floating-back\" class=\"floating-btn\">\n  <a href=\"https://cnfish.dpdns.org\" title=\"返回主域名\" aria-label=\"返回主域名\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex-shrink:0;display:block;\">\n      <path d=\"M19 12H5M12 19l-7-7 7-7\"/>\n    </svg>\n    <span style=\"display:block;font-size:12px;letter-spacing:0.5px;margin-top:-2px;\">返回</span>\n  </a>\n</div>\n\n<!-- ====== 左下角兼容模式切换按钮 ====== -->\n<div id=\"floating-compat\" class=\"floating-btn\">\n  <a href=\"?compat=1\" title=\"切换至兼容模式（无注入）\" aria-label=\"切换至兼容模式\">\n    <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"flex-shrink:0;display:block;\">\n      <path d=\"M4 4v5h5M20 20v-5h-5\"/>\n      <path d=\"M4 20l5-5M20 4l-5 5\"/>\n    </svg>\n    <span style=\"display:block;font-size:12px;letter-spacing:0.5px;margin-top:-2px;\">兼容</span>\n  </a>\n</div>\n\n<script>\n(function() {\n  'use strict';\n\n  function moveContent() {\n    var wrapper = document.getElementById('glass-wrapper');\n    if (!wrapper) return;\n\n    // 需要保留的注入元素 ID 列表\n    var keepIds = ['glass-bg', 'glass-wrapper', 'floating-back', 'floating-compat', 'github-corner-btn'];\n\n    // 获取 body 的所有子节点（快照，避免动态变化干扰）\n    var body = document.body;\n    var children = [];\n    for (var i = 0; i < body.children.length; i++) {\n      children.push(body.children[i]);\n    }\n\n    // 遍历移动\n    var moved = false;\n    for (var j = 0; j < children.length; j++) {\n      var el = children[j];\n      var id = el.id;\n      // 如果该元素 ID 在保留列表中，则跳过\n      if (keepIds.indexOf(id) !== -1) {\n        continue;\n      }\n      // 移动到 wrapper 中\n      wrapper.appendChild(el);\n      moved = true;\n    }\n\n    if (moved) {\n      // 确保 wrapper 样式正确\n      wrapper.style.display = 'flex';\n      wrapper.style.flexDirection = 'column';\n      wrapper.style.alignItems = 'center';\n      wrapper.style.justifyContent = 'center';\n      wrapper.style.width = '100%';\n\n      // 修正 h1 的 margin\n      var h1 = wrapper.querySelector('h1');\n      if (h1) h1.style.marginBottom = '16px';\n\n      var form = wrapper.querySelector('form');\n      if (form) form.style.width = '100%';\n    }\n  }\n\n  // 如果 DOM 已经加载完成，直接执行\n  if (document.readyState === 'complete' || document.readyState === 'interactive') {\n    // 但原页面可能还在修改 DOM，延迟执行\n    setTimeout(moveContent, 300);\n  } else {\n    document.addEventListener('DOMContentLoaded', function() {\n      setTimeout(moveContent, 500);\n    });\n  }\n\n  // 备用：用 MutationObserver 监控 DOM 变化，确保内容被移动\n  var observer = new MutationObserver(function() {\n    var wrapper = document.getElementById('glass-wrapper');\n    if (!wrapper) return;\n    // 检查 wrapper 内是否有有效内容（h1 或 form）\n    var hasContent = wrapper.querySelector('h1, form');\n    if (!hasContent) {\n      moveContent();\n    }\n  });\n  observer.observe(document.body, { childList: true, subtree: true });\n})();\n</script>"
        }
    ]
}
